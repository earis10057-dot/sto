# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git 에 올라가지 않습니다)

# Claude API (초안 작성·주제 추천·맞춤법) — https://console.anthropic.com
ANTHROPIC_API_KEY=
# 사용할 모델 (기본 claude-opus-5)
# BLOGAUTO_MODEL=claude-opus-5

# 네이버 오픈API (데이터랩·블로그 검색) — https://developers.naver.com > 애플리케이션 등록
# 사용 API 에서 '데이터랩(검색어트렌드)' 와 '검색' 을 추가하세요.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 네이버 검색광고 API (월간 검색량) — https://searchad.naver.com > 도구 > API 사용 관리
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=

# 알림 (선택) — 텔레그램 봇 또는 디스코드/슬랙 웹훅
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=

# 폰트 직접 지정 (선택)
# BLOGAUTO_FONT_BOLD=C:/Windows/Fonts/malgunbd.ttf
# BLOGAUTO_FONT=C:/Windows/Fonts/malgun.ttf
